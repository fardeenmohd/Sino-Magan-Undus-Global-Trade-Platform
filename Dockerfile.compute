# Multi-stage Docker Build for Python FastAPI Scraper & Compute Engine
FROM python:3.11-slim
WORKDIR /app
COPY src/main/python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir fastapi uvicorn pandas pydantic
COPY src/main/python/ .
EXPOSE 8000
CMD ["uvicorn", "compute_agent:app", "--host", "0.0.0.0", "--port", "8000"]
